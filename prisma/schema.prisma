generator client { provider = "prisma-client-js" }
datasource db { provider = "mysql" url = env("DATABASE_URL") }
enum Role { USER ADMIN }
enum UserStatus { ACTIVE DISABLED SUSPENDED BANNED }
enum AccountOwner { ADMIN USER }
enum AccountType { SHARED PERSONAL }
enum AccountStatus { ACTIVE INACTIVE MAINTENANCE }
enum PaymentStatus { PENDING DETECTED SUCCESS EXPIRED CANCELLED LATE_REVIEW }
enum WithdrawalStatus { PENDING PROCESSING PAID REJECTED FAILED }
enum LedgerType { CREDIT DEBIT }
enum LedgerReason { PAYMENT PAYMENT_FEE WITHDRAWAL WITHDRAWAL_FEE REFUND ADJUSTMENT }
enum SubscriptionStatus { ACTIVE EXPIRED CANCELLED }
model User { id Int @id @default(autoincrement()) @db.UnsignedInt; name String @db.VarChar(100); username String @unique @db.VarChar(40); email String @unique @db.VarChar(191); phone String @unique @db.VarChar(30); passwordHash String @db.VarChar(255); role Role @default(USER); status UserStatus @default(ACTIVE); feePercent Decimal @default(0.70) @db.Decimal(5,2); withdrawalFee Decimal @default(10000) @db.Decimal(18,2); personalEnabled Boolean @default(false); webhookUrl String? @db.VarChar(2048); webhookSecretHash String? @db.VarChar(128); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; wallet Wallet?; accounts PaymentAccount[]; payments Payment[]; withdrawals Withdrawal[]; withdrawalAccounts WithdrawalAccount[]; ledger WalletLedger[]; apiKeys ApiKey[]; subscriptions Subscription[]; idempotencies IdempotencyKey[]; auditLogs AuditLog[]; botSessions BotSession[]; @@index([status,createdAt]) }
model Wallet { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int @unique @db.UnsignedInt; balance Decimal @default(0) @db.Decimal(18,2); pending Decimal @default(0) @db.Decimal(18,2); user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model PaymentAccount { id Int @id @default(autoincrement()) @db.UnsignedInt; name String @db.VarChar(100); owner AccountOwner; ownerUserId Int? @db.UnsignedInt; type AccountType; provider String @db.VarChar(40); accountLabel String? @db.VarChar(191); secretRef String? @db.VarChar(255); webhookSecretRef String? @db.VarChar(255); status AccountStatus @default(ACTIVE); priority Int @default(100); weight Int @default(1); lastUsedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; ownerUser User? @relation(fields:[ownerUserId],references:[id],onDelete:SetNull); payments Payment[]; @@index([owner,type,status,priority]) }
model Payment { id Int @id @default(autoincrement()) @db.UnsignedInt; paymentId String @unique @db.VarChar(40); userId Int @db.UnsignedInt; accountId Int @db.UnsignedInt; reference String @db.VarChar(191); amount Decimal @db.Decimal(18,2); uniqueCode Int; payableAmount Decimal @db.Decimal(18,2); feeAmount Decimal @default(0) @db.Decimal(18,2); status PaymentStatus @default(PENDING); providerRef String? @db.VarChar(191); detectedAmount Decimal? @db.Decimal(18,2); detectedAt DateTime?; paidAt DateTime?; expiresAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Restrict); account PaymentAccount @relation(fields:[accountId],references:[id],onDelete:Restrict); @@unique([accountId,amount,uniqueCode]); @@index([userId,status,createdAt]); @@index([accountId,status,expiresAt]); @@index([status,expiresAt]) }
model WalletLedger { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int @db.UnsignedInt; type LedgerType; reason LedgerReason; amount Decimal @db.Decimal(18,2); reference String @unique @db.VarChar(64); description String? @db.VarChar(255); createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,createdAt]) }
model WithdrawalAccount { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int @db.UnsignedInt; bankCode String @db.VarChar(30); accountName String @db.VarChar(100); accountNumber String @db.VarChar(50); isDefault Boolean @default(false); verified Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); withdrawals Withdrawal[] }
model Withdrawal { id Int @id @default(autoincrement()) @db.UnsignedInt; withdrawalId String @unique @db.VarChar(40); userId Int @db.UnsignedInt; accountId Int @db.UnsignedInt; amount Decimal @db.Decimal(18,2); feeAmount Decimal @db.Decimal(18,2); netAmount Decimal @db.Decimal(18,2); status WithdrawalStatus @default(PENDING); providerRef String? @db.VarChar(191); note String? @db.VarChar(255); createdAt DateTime @default(now()); processedAt DateTime?; user User @relation(fields:[userId],references:[id],onDelete:Restrict); account WithdrawalAccount @relation(fields:[accountId],references:[id],onDelete:Restrict); @@index([userId,status,createdAt]) }
model ApiKey { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int @db.UnsignedInt; name String @db.VarChar(80); keyHash String @unique @db.VarChar(128); prefix String @db.VarChar(20); active Boolean @default(true); lastUsedAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,active]) }
model Subscription { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int @db.UnsignedInt; plan String @db.VarChar(50); price Decimal @db.Decimal(18,2); status SubscriptionStatus @default(ACTIVE); startsAt DateTime; endsAt DateTime; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,status,endsAt]) }
model PricingSetting { id Int @id @default(autoincrement()) @db.UnsignedInt; key String @unique @db.VarChar(80); value String @db.VarChar(255); enabled Boolean @default(true); updatedAt DateTime @updatedAt }
model WebhookLog { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int? @db.UnsignedInt; event String @db.VarChar(80); target String @db.VarChar(2048); status Int; response String? @db.Text; createdAt DateTime @default(now()); @@index([userId,createdAt]) }
model IdempotencyKey { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int @db.UnsignedInt; key String @db.VarChar(191); requestHash String @db.VarChar(128); responseJson String? @db.Text; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([userId,key]) }
model AuditLog { id Int @id @default(autoincrement()) @db.UnsignedInt; userId Int? @db.UnsignedInt; action String @db.VarChar(100); entity String? @db.VarChar(100); entityId String? @db.VarChar(100); ip String? @db.VarChar(64); metadata String? @db.Text; createdAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); @@index([userId,createdAt]) }
model BotSession { id Int @id @default(autoincrement()) @db.UnsignedInt; jid String @unique @db.VarChar(191); userId Int; tokenCiphertext String @db.Text; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]) }
